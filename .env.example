# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resume_roaster

# Redis (rate limiting now; arq queue in V2)
REDIS_URL=redis://localhost:6379/0

# AI Provider (fast + heavy tiers — see ARCHITECTURE.md §12)
AI_PROVIDER=openai
AI_MODEL=gpt-4o
AI_FAST_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=

# Auth (access token in memory, refresh token in HttpOnly cookie)
JWT_SECRET_KEY=change-this-to-a-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# File Storage (R2 vars are V2-only — uncomment when needed)
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT_URL=

# App
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_FREE=3
RATE_LIMIT_PRO=50
LOGIN_RATE_LIMIT_PER_HOUR=10

# Observability (optional)
SENTRY_DSN=
