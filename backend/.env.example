# Database (DATABASE_URL wins when set; otherwise DB_* parts are combined)
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=resume_roaster
DATABASE_URL=

# Redis (rate limiting now; arq queue in V2)
REDIS_URL=redis://localhost:6379/0

# AI Provider
AI_PROVIDER=openai
AI_MODEL=gpt-4o
AI_FAST_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=

# Auth
JWT_SECRET_KEY=change-this-to-a-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# File Storage
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# App
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_FREE=3
RATE_LIMIT_PRO=50
LOGIN_RATE_LIMIT_PER_HOUR=10

# Stores (memory = zero infra, used by tests; postgres = real database)
USER_STORE=postgres
DENYLIST_STORE=memory

# Demo account seeded at startup (leave blank to skip seeding)
DEMO_USER_EMAIL=demo@airoast.dev
DEMO_USER_PASSWORD=Demo@12345
DEMO_USER_NAME=Demo User
